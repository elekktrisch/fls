{
  "$schema": "https://docs.fallow.tools/schema/fallowrc.json",
  "ignorePatterns": [
    "**/node_modules.windows/**",
    "src/app/api/generated/**",
    "dist/**",
    "coverage/**"
  ],
  "ignoreDependencies": ["@angular/animations"],
  "ignoreUnresolvedImports": ["orval"],
  "health": {
