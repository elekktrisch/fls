  "components" : {
    "schemas" : {
      "InOutboundPointRequest" : {
        "type" : "object",
        "description" : "Payload to create / replace an InOutboundPoint under a Location.",
        "properties" : {
          "pointName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "pointType" : {
            "type" : "string",
            "maxLength" : 50,
            "minLength" : 0
          },
          "direction" : {
            "type" : "string",
            "maxLength" : 50,
            "minLength" : 0
          },
          "description" : {
            "type" : "string"
          }
        },
        "required" : [ "pointName" ]
      },
      "LocationUpdateRequest" : {
        "type" : "object",
        "description" : "Payload to update a Location. Replaces the full IOP list (orphan-removal cleans up).",
        "properties" : {
          "locationName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "locationShortName" : {
            "type" : "string",
            "maxLength" : 50,
            "minLength" : 0
          },
          "countryId" : {
            "type" : "string",
            "format" : "uuid",
            "example" : "019e2e15-2c00-74be-8000-0000000004be",
            "pattern" : "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "locationTypeId" : {
            "type" : "string",
            "format" : "uuid",
            "example" : "019e2e15-2c00-72c9-8000-0000000032c9",
            "pattern" : "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "icaoCode" : {
            "type" : "string",
            "maxLength" : 10,
            "minLength" : 0,
            "pattern" : "^[A-Z]{4}$|^[A-Z]{2}[0-9]{2}$"
          },
          "latitude" : {
            "type" : "string",
            "maxLength" : 10,
            "minLength" : 0
          },
          "longitude" : {
            "type" : "string",
            "maxLength" : 10,
            "minLength" : 0
          },
          "elevation" : {
            "type" : "integer",
            "format" : "int32"
          },
          "elevationUnitTypeId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "runwayDirection" : {
            "type" : "string",
            "maxLength" : 50,
            "minLength" : 0
          },
          "runwayLength" : {
            "type" : "integer",
            "format" : "int32"
          },
          "runwayLengthUnitTypeId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "airportFrequency" : {
            "type" : "string",
            "maxLength" : 50,
            "minLength" : 0
          },
          "description" : {
            "type" : "string"
