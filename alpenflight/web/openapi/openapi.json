{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "AlpenFlight API",
    "description" : "Glider club operations platform. Source of truth for the SPA-generated TS client."
  },
  "servers" : [ {
    "url" : "http://localhost:8080"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "name" : "Countries",
    "description" : "ISO-3166 country catalog."
  }, {
    "name" : "Locations",
    "description" : "Locations CRUD (per-club masterdata)."
  }, {
    "name" : "Locations Admin",
    "description" : "SYSTEM_ADMINISTRATOR cross-tenant Locations management."
  }, {
    "name" : "ClubStates",
    "description" : "Club lifecycle-state catalog."
  }, {
    "name" : "LocationTypes",
    "description" : "Location-type reference catalog."
  }, {
    "name" : "Clubs",
    "description" : "Clubs CRUD."
  } ],
  "paths" : {
    "/api/v1/locations/{id}" : {
      "get" : {
        "tags" : [ "Locations" ],
        "summary" : "Read a single Location by id (includes nested IOPs).",
        "operationId" : "getLocation",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "example" : "loc-019e30c3-2c00-7001-8000-000000000001",
            "pattern" : "^loc-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Location detail projection.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LocationDetail"
                }
              }
            }
          },
          "404" : {
            "description" : "No active location with that id.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LocationDetail"
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "Locations" ],
        "summary" : "Update a Location. PUT body replaces the full IOP list.",
        "operationId" : "updateLocation",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "example" : "loc-019e30c3-2c00-7001-8000-000000000001",
            "pattern" : "^loc-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LocationUpdateRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Updated; body is the new state.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LocationDetail"
                }
              }
            }
          },
          "400" : {
            "description" : "Validation failed.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LocationDetail"
                }
              }
            }
          },
          "404" : {
            "description" : "No active location with that id.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LocationDetail"
                }
              }
            }
          },
          "409" : {
            "description" : "ICAO code already in use by another Location.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LocationDetail"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "Locations" ],
        "summary" : "Soft-delete a Location.",
        "operationId" : "deleteLocation",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "example" : "loc-019e30c3-2c00-7001-8000-000000000001",
            "pattern" : "^loc-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Deleted."
          },
          "404" : {
            "description" : "No active location with that id."
          }
        }
      }
    },
