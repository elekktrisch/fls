<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="AlpenFlight maintainability"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

  <description>
    Curated PMD ruleset for the AlpenFlight server (J-5 T-11, boyscout rider).

    Scope = the two maintainability axes the architecture guards
    (Spring Modulith ApplicationModulesTest + ArchUnit) do NOT cover:
      1. COMPLEXITY  — cyclomatic / cognitive / NPath / method+class length,
                       too-many-fields/methods, excessive parameters.
      2. DEAD / UNUSED CODE — unused private fields / methods / locals,
                              unused formal parameters, empty bodies.

    Deliberately NOT the full PMD default. Style / naming / documentation /
    formatting categories are excluded so the report stays a signal about
    maintainability (complexity + dead code), not a flood of cosmetic noise
    that nobody actions. Duplication is the CPD half (de.aaschmid.cpd, see
    build.gradle.kts) — PMD does not cover copy-paste.

    Thresholds are tuned to flag genuine hotspots, not ordinary code: they
    sit a little above the "honest healthy" baseline (the reservations
    aggregate, deliberately built low-complexity in J-5 T-03/T-09, must come
    out clean). ratchet posture: report-generating, NOT a hard build fail on
    today's debt — `pmdMain.ignoreFailures = true` in build.gradle.kts. The
    XML report is the panel feed (J-5 T-12/T-13 consume it).
  </description>

  <!-- ===================================================================
       1. COMPLEXITY
       =================================================================== -->

  <!-- Cyclomatic complexity per method/class. PMD 7 defaults
       methodReportLevel=10 / classReportLevel=80; we hold the method default
       so the report agrees with the operator's "cyc" numbers from fallow on
       the TS side, and tighten the class level a little. -->
  <rule ref="category/java/design.xml/CyclomaticComplexity">
    <properties>
      <property name="methodReportLevel" value="10"/>
      <property name="classReportLevel" value="60"/>
    </properties>
  </rule>

  <!-- Cognitive complexity — the "how hard to read" axis (nesting-weighted),
       the closest PMD analog to fallow's cognitive/CRAP score. Java rule
       since PMD 6.35 (https://docs.pmd-code.org/latest/pmd_rules_java_design.html). -->
  <rule ref="category/java/design.xml/CognitiveComplexity">
    <properties>
      <property name="reportLevel" value="15"/>
    </properties>
  </rule>

  <!-- NPath — number of acyclic execution paths; catches deeply-branched
       methods cyclomatic alone misses. -->
  <rule ref="category/java/design.xml/NPathComplexity">
    <properties>
      <property name="reportLevel" value="200"/>
    </properties>
  </rule>

  <!-- Oversize method / class bodies — the LOC axis of the hotspot list.
       PMD 7 retired Excessive{Method,Class}Length in favour of NcssCount
       (non-commenting source statements; reports both method and class). -->
  <rule ref="category/java/design.xml/NcssCount">
    <properties>
      <property name="methodReportLevel" value="60"/>
      <property name="classReportLevel" value="1000"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/ExcessiveParameterList">
    <properties>
      <property name="minimum" value="8"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/TooManyMethods">
    <properties>
      <property name="maxmethods" value="25"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/TooManyFields">
    <properties>
      <property name="maxfields" value="20"/>
    </properties>
  </rule>

  <!-- ===================================================================
       2. DEAD / UNUSED CODE
       =================================================================== -->

  <rule ref="category/java/bestpractices.xml/UnusedPrivateField"/>
  <rule ref="category/java/bestpractices.xml/UnusedPrivateMethod"/>
  <rule ref="category/java/bestpractices.xml/UnusedLocalVariable"/>
  <rule ref="category/java/bestpractices.xml/UnusedAssignment"/>
  <!-- Unused formal parameters, but allow the common interface/override and
       Spring-callback cases that legitimately ignore an arg. -->
  <rule ref="category/java/bestpractices.xml/UnusedFormalParameter">
    <properties>
      <property name="checkAll" value="false"/>
    </properties>
  </rule>

  <!-- Empty / no-op bodies that usually mean dead or forgotten code. -->
  <rule ref="category/java/codestyle.xml/EmptyControlStatement"/>
  <rule ref="category/java/errorprone.xml/EmptyCatchBlock">
    <properties>
      <property name="allowCommentedBlocks" value="true"/>
    </properties>
  </rule>

</ruleset>
