    "generate:api": "openapi-generator-cli generate -i ../../server/platform/build/openapi/openapi.json -g typescript-angular -o src/generated/openapi --global-property models,modelDocs=false --additional-properties=ngVersion=22.0.1,fileNaming=kebab-case,supportsES6=true"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "idb": "8.0.3",
    "ng-zorro-antd": "22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.0",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
