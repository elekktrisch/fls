# alpenflight/auth/.env.example
#
# Per-developer env file feeding the keycloak compose service. Copy to
# `alpenflight/auth/.env` (gitignored) and fill in. Defaults in
# docker-compose.yml's `${VAR:-default}` blocks cover the empty-file case,
# so the stack still boots without this file — `.env` is for when you
# want a real Google OAuth client or to point at a different SMTP host.
#
# Syntax: bare KEY=value. Do NOT wrap values in ${...} — docker treats $
# literally in env files, so the value would be passed through as-is.
#
# Used by docker-compose.yml's keycloak `env_file:` directive (NOT
# auto-loaded; the file path is explicit).

# ---------------------------------------------------------------------------
# Google IdP — per-developer OAuth client (Google policy: secrets are not
# sharable across developers). Same env names dev + prod; production deploy
# sets these via the deploy pipeline, not from a .env file.
#
# Sentinel `set-via-env-for-google-signup` (set as the compose default in
# docker-compose.yml when both are empty) lets the realm boot and serves
# Keycloak's `invalid_client` page on click — "feature is off" signal.
# ---------------------------------------------------------------------------

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID -> Web application
# Authorized redirect URI: http://localhost:8090/realms/alpenflight/broker/google/endpoint
# Authorized JS origin:    http://localhost:8090
KEYCLOAK_GOOGLE_CLIENT_ID=
KEYCLOAK_GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# SMTP — defaults to the compose `mailpit` service (no auth, no TLS). Set
# these to point at a different SMTP host (e.g. a personal Mailtrap inbox).
# ---------------------------------------------------------------------------

KEYCLOAK_SMTP_HOST=
KEYCLOAK_SMTP_PORT=
KEYCLOAK_SMTP_FROM=
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_AUTH=
KEYCLOAK_SMTP_STARTTLS=

# ---------------------------------------------------------------------------
# alpenflight-web client baseUrl — the SPA's main URL. Feeds:
#   - the login page "Back to Start" footer href (themes/alpenflight/login/footer.ftl)
#   - the account-console "back to application" link
# Dev: http://localhost:4200/ (trailing slash matters — rendered verbatim into href).
# Prod: the real SPA origin.
# ---------------------------------------------------------------------------

ALPENFLIGHT_WEB_BASE_URL=
