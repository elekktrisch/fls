# alpenflight/auth/.env.example — committed defaults for the keycloak
# container's process env. Loaded as the FIRST env_file by docker-compose.yml,
# with `alpenflight/auth/.env` (gitignored) loaded second to override per-laptop.
#
# Why a committed defaults file: compose's `environment:` block ALWAYS
# overrides env_file, so we can't keep `${VAR:-default}` in `environment:`
# without silently shadowing whatever the operator sets in `.env`. Defaults
# live here instead; operators override by copying to `.env` and editing only
# the lines they need.
#
# Syntax: bare KEY=value. Do NOT wrap values in ${...} — docker treats $
# literally in env files, so the value would be passed through as-is.
#
# Quick-start:
#   cp alpenflight/auth/.env.example alpenflight/auth/.env
#   $EDITOR alpenflight/auth/.env
#   docker compose -p alpenflight-dev up -d --force-recreate keycloak

# ---------------------------------------------------------------------------
# Google IdP — per-developer OAuth client (Google policy: secrets are not
# sharable across developers). Same env names dev + prod; production deploy
# sets these via the deploy pipeline.
#
# Sentinel `set-via-env-for-google-signup` keeps the realm import working
# without real credentials — clicking "Continue with Google" then renders
# Keycloak's stock `invalid_client` page (Google's "feature is off" signal).
# Replace with real Cloud Console values to enable Google sign-in locally.
# ---------------------------------------------------------------------------

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID -> Web application
# Authorized redirect URI: http://localhost:8090/realms/alpenflight/broker/google/endpoint
# Authorized JS origin:    http://localhost:8090
KEYCLOAK_GOOGLE_CLIENT_ID=set-via-env-for-google-signup
KEYCLOAK_GOOGLE_CLIENT_SECRET=set-via-env-for-google-signup

# ---------------------------------------------------------------------------
# SMTP — defaults point at the compose `mailpit` service (no auth, no TLS).
# Override to point at a different SMTP host (e.g. a personal Mailtrap inbox).
# ---------------------------------------------------------------------------

KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=noreply@alpenflight.local
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_AUTH=false
KEYCLOAK_SMTP_STARTTLS=false

# ---------------------------------------------------------------------------
# alpenflight-web client baseUrl is BUILD-TIME, not runtime — see the
# Dockerfile's ALPENFLIGHT_WEB_BASE_URL build-arg + docker-compose.yml
# build.args. NOT consumed via env_file (would be too late: client.baseUrl
# is validated at realm-import). Set via shell env or repo-root `.env` for
# the compose `${VAR:-...}` interpolation that feeds the build-arg.
# ---------------------------------------------------------------------------
