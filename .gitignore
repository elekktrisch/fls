# JetBrains — ignore the whole .idea folder + every .iml. Files currently
# tracked under .idea/ stay tracked (gitignore doesn't retroactively apply);
# run `git rm --cached -r .idea/ '*.iml'` to untrack them if desired.
.idea/
*.iml

# OS junk
.DS_Store
Thumbs.db

/node_modules
e2e/node_modules
e2e/playwright-report
e2e/screenshots

# Claude Code session state (per-process tasks, worktrees) — ignore the
# whole .claude/ tree by default, but track deliberate artifacts: skills,
# agents, the project's accumulated auto-memory (engineering notes that
# survive a sandbox container reset; bootstrap procedure in CLAUDE.md), and
# the shared project settings + their hook scripts (settings.local.json stays
# local/ignored).
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/memory/
!.claude/settings.json
!.claude/hooks/
alpenflight/server/build
alpenflight/server/.gradle
alpenflight/web/node_modules
alpenflight/web/node_modules_sandbox
alpenflight/web/node_modules.windows
alpenflight/web/scripts/node_modules
alpenflight/web/dist
alpenflight/web/.angular
.pnpm-store/

# Per-developer Keycloak env (Google OAuth client secrets, SMTP overrides,
# SPA base URL). .env.example is the committed template.
alpenflight/auth/.env
# J-7 T-21: e2e diagnostic screenshots (alpenflight/web/e2e) — not matched by the root /screenshots rule
alpenflight/web/e2e/screenshots/
